rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= זהויות =================
    function signedIn() { return request.auth != null; }

    // משתמש אמיתי = לא אנונימי (Google או אימייל+סיסמה)
    function isRealUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // מנהל-העל — אותו חשבון שבו נכנסים ל-admin.html
    function isSuperAdmin() {
      return signedIn() && request.auth.uid == '83rxsZbqtANkW6qoj3DlBPGNtNn1';
    }

    function groupPath(gid) { return /databases/$(database)/documents/groups/$(gid); }
    function groupData(gid) { return get(groupPath(gid)).data; }

    // מנהל קבוצה = מופיע במפת admins של הקבוצה (או מנהל-העל)
    function isGroupAdmin(gid) {
      return isSuperAdmin()
        || (isRealUser() && request.auth.uid in groupData(gid).get('admins', {}));
    }

    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function validAdminName(m, uid) {
      return m[uid] is string && m[uid].size() > 0 && m[uid].size() <= 60;
    }

    // רשימת מזהי המנהלים (לשאילתת "הקבוצות שלי") חייבת להיות זהה למפתחות של admins
    function adminUidsOk(d) {
      return !('adminUids' in d)
        || (d.adminUids is list
            && ('admins' in d)
            && d.adminUids.size() == d.admins.size()
            && d.adminUids.hasAll(d.admins.keys()));
    }

    // שדות תיאור הקבוצה: מיקום, זמנים ופרסום
    function groupFieldsOk(d) {
      return d.size() < 40
        && (!('visibility' in d) || d.visibility in ['public', 'private'])
        && (!('location' in d) || (d.location is map && d.location.size() <= 4))
        && (!('schedule' in d) || (d.schedule is map && d.schedule.size() <= 4))
        && (!('listingId' in d) || (d.listingId is string && d.listingId.size() <= 40))
        && (!('icon' in d) || (d.icon is string && d.icon.size() <= 40000))
        && (!('regSchedule' in d) || (d.regSchedule is map && d.regSchedule.size() <= 8))
        && (!('source' in d) || (d.source is string && d.source.size() <= 20))
        && (!('marketPostId' in d) || (d.marketPostId is string && d.marketPostId.size() <= 40));
    }

    // ולידציה בסיסית לכרטיס שחקן — עוצרת זבל ומסמכי ענק
    function validPlayer() {
      let d = request.resource.data;
      return d.name is string
        && d.name.size() > 0
        && d.name.size() < 80
        && d.size() < 60;
    }

    // ================= קבוצה =================

    // קבוצה חדשה: היוצר הוא הבעלים והמנהל היחיד, ואין סיסמה
    function newGroupOk() {
      let d = request.resource.data;
      return d.ownerUid == request.auth.uid
        && d.admins is map
        && d.admins.keys().hasOnly([request.auth.uid])
        && d.admins.size() == 1
        && validAdminName(d.admins, request.auth.uid)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && !('password' in d)
        && adminUidsOk(d)
        && groupFieldsOk(d);
    }

    // עדכון רגיל של מנהל. רק הבעלים משנה את רשימת המנהלים ואת הפרסום, ולא ניתן להחזיר סיסמה
    function adminUpdateOk() {
      let d = request.resource.data;
      let isOwner = resource.data.get('ownerUid', '') == request.auth.uid;
      return !('password' in d)
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && adminUidsOk(d)
        && groupFieldsOk(d)
        && (!changedKeys().hasAny(['admins', 'ownerUid', 'visibility', 'listingId'])
            || (isOwner && d.ownerUid == request.auth.uid && request.auth.uid in d.admins));
    }

    // העברת קבוצה ותיקה (סיסמה) לבעלות חשבון. הסיסמה נבדקת במסמך claims באותה פעולה
    function legacyClaimOk(gid) {
      let d = request.resource.data;
      return isRealUser()
        && !('ownerUid' in resource.data)
        && !('admins' in resource.data)
        && changedKeys().hasOnly(['ownerUid', 'admins', 'password', 'adminUids'])
        && adminUidsOk(d)
        && d.ownerUid == request.auth.uid
        && d.admins is map
        && d.admins.keys().hasOnly([request.auth.uid])
        && d.admins.size() == 1
        && validAdminName(d.admins, request.auth.uid)
        && !('password' in d)
        && existsAfter(/databases/$(database)/documents/groups/$(gid)/claims/$(request.auth.uid));
    }

    // הצטרפות כמנהל עם קישור הזמנה — ההזמנה חייבת להימחק באותה פעולה (חד-פעמית)
    function inviteJoinOk(gid) {
      let d = request.resource.data;
      return isRealUser()
        && ('admins' in resource.data)
        && !(request.auth.uid in resource.data.admins)
        && changedKeys().hasOnly(['admins', 'joinedWithInvite', 'adminUids'])
        && adminUidsOk(d)
        && d.admins.diff(resource.data.admins).affectedKeys().hasOnly([request.auth.uid])
        && request.auth.uid in d.admins
        && validAdminName(d.admins, request.auth.uid)
        && d.joinedWithInvite is string
        && d.joinedWithInvite.matches('^[a-f0-9]{32}$')
        && inviteConsumed(gid, d.joinedWithInvite);
    }

    function inviteConsumed(gid, code) {
      let p = /databases/$(database)/documents/groups/$(gid)/adminInvites/$(code);
      return exists(p)
        && get(p).data.expiresAt > request.time
        && !existsAfter(p);
    }

    // הסיסמה הישנה: באחסון המוגן אם הועברה, אחרת עדיין במסמך הקבוצה
    function legacyPassword(gid) {
      let priv = /databases/$(database)/documents/groups/$(gid)/private/legacy;
      return exists(priv) ? get(priv).data.get('password', '') : groupData(gid).get('password', '');
    }

    // ================= שחקנים =================

    // הרשמה למשחק מעלה את מונה ההרשמות באחד
    function registrationBumpOk() {
      return changedKeys().hasOnly(['registrationCount'])
        && request.resource.data.registrationCount == resource.data.get('registrationCount', 0) + 1;
    }

    // דירוג מפורטל ההצבעה: רק שדות הדירוג, ורק מי שמחזיק בקישור הצבעה ששויך אליו
    function voterRatingOk(gid) {
      let d = request.resource.data;
      return signedIn()
        && changedKeys().hasOnly([
             'votesCount', 'attScore', 'defScore',
             'atk', 'def', 'sta', 'pac', 'pas',
             'sumAtk', 'sumDef', 'sumSta', 'sumPac', 'sumPas',
             'customSums', 'customAvgs', 'customStats',
             'gkSums', 'gkDiv', 'gkHan', 'gkKic', 'gkPos', 'gkRef', 'gkScore',
             'lastVoteToken'])
        && d.lastVoteToken is string
        && d.lastVoteToken.matches('^[A-Za-z0-9_-]{8,64}$')
        && voterOwns(gid, d.lastVoteToken);
    }

    function voterOwns(gid, token) {
      return get(/databases/$(database)/documents/groups/$(gid)/voters/$(token)).data.get('uid', null) == request.auth.uid;
    }

    // ================= קישורי הצבעה =================
    function voterClaimOk() {
      return signedIn()
        && resource.data.get('uid', null) == null
        && request.resource.data.uid == request.auth.uid
        && changedKeys().hasOnly(['uid', 'claimedAt', 'lastSeen']);
    }

    function voterTouchOk() {
      return signedIn()
        && resource.data.get('uid', null) == request.auth.uid
        && changedKeys().hasOnly(['lastSeen', 'votedCount'])
        && request.resource.data.get('votedCount', 0) <= resource.data.get('votedCount', 0) + 1;
    }

    // ================= MVP =================
    function mvpVoteOk() {
      return resource.data.get('votingOpen', true) != false
        && changedKeys().hasOnly(['mvpVotes', 'mvpVoteCount', 'mvpWinner'])
        && request.resource.data.mvpVotes is map
        && request.resource.data.mvpVoteCount is number
        && request.resource.data.mvpVoteCount <= resource.data.get('mvpVoteCount', 0) + 1
        && mvpWinnerOk(request.resource.data.get('mvpWinner', null));
    }

    // הזוכה נכתב על ידי המצביעים ומוצג בדף הקבוצה: שם בלי תגיות HTML ומספרים בלבד
    function mvpWinnerOk(w) {
      return w == null
        || (w is map
            && w.keys().hasOnly(['id', 'name', 'votes', 'totalVotes'])
            && w.get('name', '') is string && w.get('name', '').size() < 80
            && !w.get('name', '').matches('.*[<>].*')
            && w.get('votes', 0) is number
            && w.get('totalVotes', 0) is number);
    }

    // ================= הרשמה למשחק =================
    // פתוחה = open, ובהרשמה אוטומטית גם אחרי מועד הפתיחה (opensAt) לפי שעון השרת
    function registrationOpen(gid, regId) {
      let r = get(/databases/$(database)/documents/groups/$(gid)/registrations/$(regId)).data;
      return r.get('open', false) == true
        && (r.get('opensAt', null) == null || request.time >= r.opensAt);
    }

    function validEntry(gid, pid) {
      let d = request.resource.data;
      return d.playerId == pid
        && d.name is string && d.name.size() < 80
        && d.isWaiting is bool
        && d.size() < 30
        && exists(/databases/$(database)/documents/groups/$(gid)/players/$(pid));
    }

    // ================= נתיבים =================

    match /groups/{gid} {
      // כל מי שיש לו את הקישור רואה את הקבוצה. רשימה: רק הקבוצות שאני מנהל (או מנהל-העל)
      allow get: if true;
      allow list: if isSuperAdmin()
                  || (isRealUser() && request.auth.uid in resource.data.adminUids);

      allow create: if isRealUser() && newGroupOk();
      allow update: if isSuperAdmin()
                    || (isGroupAdmin(gid) && adminUpdateOk())
                    || legacyClaimOk(gid)
                    || inviteJoinOk(gid);
      // מחיקה: מנהל-העל, או הבעלים של הקבוצה (תתי-האוספים נמחקים לפני כן מהאפליקציה)
      allow delete: if isSuperAdmin()
                    || (isRealUser() && resource.data.get('ownerUid', '') == request.auth.uid);

      // הסיסמה הישנה אחרי ההעברה — אף משתמש לא קורא אותה
      match /private/{docId} {
        allow read, write: if isSuperAdmin();
      }

      // הוכחת סיסמה בזמן העברת קבוצה ותיקה. לא קריא, לא ניתן לשינוי
      match /claims/{uid} {
        allow read, update, delete: if false;
        allow create: if isRealUser()
          && uid == request.auth.uid
          && !('ownerUid' in groupData(gid))
          && request.resource.data.keys().hasOnly(['password', 'at'])
          && request.resource.data.password is string
          && request.resource.data.password.size() > 0
          && request.resource.data.password == legacyPassword(gid);
      }

      // קישורי הזמנה למנהל נוסף
      match /adminInvites/{code} {
        allow get, list: if isGroupAdmin(gid);
        allow create: if isGroupAdmin(gid)
          && code.matches('^[a-f0-9]{32}$')
          && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
        allow update: if false;
        // המוזמן מוחק את ההזמנה באותה פעולה שבה הוא נכנס לרשימת המנהלים
        allow delete: if isGroupAdmin(gid)
          || (isRealUser() && request.auth.uid in getAfter(groupPath(gid)).data.get('admins', {}));
      }

      match /players/{playerId} {
        allow read: if true;
        allow create: if isGroupAdmin(gid) && validPlayer();
        allow update: if (isGroupAdmin(gid) && validPlayer())
                      || registrationBumpOk()
                      || voterRatingOk(gid);
        allow delete: if isGroupAdmin(gid);
      }

      match /game/{docId} {
        allow read: if true;
        allow write: if isGroupAdmin(gid);
      }

      match /history/{docId} {
        allow read: if true;
        allow write: if isGroupAdmin(gid);
      }

      match /history_games/{docId} {
        allow read: if true;
        allow create, delete: if isGroupAdmin(gid);
        allow update: if isGroupAdmin(gid) || mvpVoteOk();
      }

      match /registrations/{regId} {
        allow read: if true;
        allow write: if isGroupAdmin(gid);

        match /entries/{entryId} {
          allow read: if true;
          allow create: if isGroupAdmin(gid)
                        || (registrationOpen(gid, regId) && validEntry(gid, entryId));
          // שחקן שנרשם יכול רק להעביר שחקן אחר להמתנה (דחיקה לפי עדיפות)
          allow update: if isGroupAdmin(gid)
                        || (registrationOpen(gid, regId)
                            && changedKeys().hasOnly(['isWaiting'])
                            && request.resource.data.isWaiting == true);
          allow delete: if isGroupAdmin(gid);
        }
        match /cancelled/{docId} {
          allow read: if true;
          allow write: if isGroupAdmin(gid);
        }
      }

      // ===== קישורי הצבעה אישיים =====
      match /voters/{token} {
        // הטוקן הוא הסוד שבקישור; רשימת כל הטוקנים — למנהלים בלבד.
        // קישור שכבר שויך למכשיר (ובו שם המדרג) — רק המכשיר הזה והמנהלים קוראים אותו
        allow get: if signedIn()
                   && (resource == null
                       || resource.data.get('uid', null) == null
                       || resource.data.uid == request.auth.uid
                       || isGroupAdmin(gid));
        allow list: if isGroupAdmin(gid);
        allow create: if isGroupAdmin(gid) && request.resource.data.get('uid', null) == null;
        allow update: if isGroupAdmin(gid) || voterClaimOk() || voterTouchOk();
        allow delete: if isGroupAdmin(gid);

        // ההצבעות עצמן — הבעלים של הטוקן, או מנהלי הקבוצה לתחזוקה
        match /votes/{playerId} {
          allow read, write: if isGroupAdmin(gid) || voterOwns(gid, token);
        }
      }
    }

    // לוח "מחפשים שחקן": מודעה עם מזהה אקראי ובלי מזהה הקבוצה, כדי שהמודעה לא תחשוף את הקישור לקבוצה.
    // expiresAt: עד מתי מוצגת — 24 שעות, או מודעה קבועה (permanent) שנשארת עד שמורידים אותה, ולכל היותר כשנה (400 יום).
    // מודעות ישנות נשמרו עם מזהה הקבוצה כמזהה — מנהלי הקבוצה מוחקים אותן
    function marketPostOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'groupName', 'location', 'phone', 'missing', 'timestamp', 'expiresAt', 'permanent'])
        && d.ownerUid == request.auth.uid
        && d.groupName is string && d.groupName.size() <= 100
        && d.location is string && d.location.size() > 0 && d.location.size() <= 100
        && d.phone is string && d.phone.size() <= 20
        && d.missing is int && d.missing > 0 && d.missing <= 99
        && d.timestamp == request.time
        && (!('permanent' in d) || d.permanent is bool)
        && d.expiresAt is int
        && (d.expiresAt <= request.time.toMillis() + 172800000
            || (d.get('permanent', false) == true && d.expiresAt <= request.time.toMillis() + 34560000000));
    }

    // לאיזו קבוצה שייכת המודעה (market_posts/{postId}/private/group). כל מנהל בקבוצה רשאי להוריד אותה
    function marketPostGroupAdmin(postId) {
      let p = /databases/$(database)/documents/market_posts/$(postId)/private/group;
      return exists(p) && isGroupAdmin(get(p).data.gid);
    }

    match /market_posts/{postId} {
      allow read: if true;
      allow create: if isRealUser() && marketPostOk();
      allow update: if false;
      allow delete: if isSuperAdmin()
                    || (resource != null && resource.data.get('ownerUid', '') == request.auth.uid)
                    || marketPostGroupAdmin(postId)
                    || isGroupAdmin(postId);

      // הקישור לקבוצה מוסתר מכולם: המודעה ציבורית, ומזהה הקבוצה הוא המפתח לדף הקבוצה. רק חוקי האבטחה קוראים אותו.
      // נוצר פעם אחת, בידי מי שפרסם את המודעה, ורק אם הוא מנהל בקבוצה
      match /private/group {
        allow read, update: if false;
        allow create: if isRealUser()
          && request.resource.data.keys().hasOnly(['gid'])
          && request.resource.data.gid is string
          && request.resource.data.gid.matches('^[A-Za-z0-9_-]{1,40}$')
          && isGroupAdmin(request.resource.data.gid)
          && getAfter(/databases/$(database)/documents/market_posts/$(postId)).data.ownerUid == request.auth.uid;
        allow delete: if isSuperAdmin() || isGroupAdmin(resource.data.gid);
      }
    }

    // ===== "מצא קבוצה": מודעה שהבעלים של קבוצה ציבורית מפרסם =====
    // המודעה לא כוללת את מזהה הקבוצה, כדי שהקישור לקבוצה יישאר אצל המארגן.
    // looking: מחפשים שחקנים · lat/lng: המגרש במפה · regAuto: ההרשמה השבועית · openGame: הרשמה ידנית פתוחה
    function listingOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid', 'name', 'city', 'venue', 'days', 'time', 'level', 'description', 'phone', 'icon', 'createdAt', 'updatedAt',
                               'looking', 'lat', 'lng', 'regAuto', 'openGame'])
        && d.ownerUid == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.city is string && d.city.size() > 0 && d.city.size() <= 40
        && (!('venue' in d) || (d.venue is string && d.venue.size() <= 60))
        && (!('days' in d) || (d.days is list && d.days.size() <= 7))
        && (!('time' in d) || (d.time is string && d.time.size() <= 5))
        && (!('level' in d) || (d.level is string && d.level.size() <= 20))
        && (!('description' in d) || (d.description is string && d.description.size() <= 300))
        && (!('icon' in d) || (d.icon is string && d.icon.size() <= 40000))
        && d.phone is string && d.phone.matches('^0[0-9]{8,9}$')
        && (!('looking' in d) || d.looking is bool)
        && (!('lat' in d) || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (!('lng' in d) || (d.lng is number && d.lng >= -180 && d.lng <= 180))
        && (!('regAuto' in d) || (d.regAuto is map
              && d.regAuto.keys().hasOnly(['days', 'time', 'openDaysBefore', 'openTime'])
              && d.regAuto.get('days', []) is list && d.regAuto.get('days', []).size() <= 7
              && d.regAuto.get('time', '') is string && d.regAuto.get('time', '').size() <= 5
              && d.regAuto.get('openTime', '') is string && d.regAuto.get('openTime', '').size() <= 5
              && d.regAuto.get('openDaysBefore', 0) is int))
        && (!('openGame' in d) || (d.openGame is map && d.openGame.keys().hasOnly(['at']) && d.openGame.at is timestamp));
    }

    match /listings/{listingId} {
      allow read: if true;
      allow create: if isRealUser() && listingOk();
      allow update: if isRealUser() && resource.data.ownerUid == request.auth.uid && listingOk();
      allow delete: if isSuperAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // ===== טופס "צור קשר": כל מבקר שולח (גם עם מזהה אנונימי), רק מנהל-העל קורא ומוחק =====
    function contactMessageOk() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasAll(['topic', 'message', 'uid', 'createdAt'])
        && d.keys().hasOnly(['topic', 'message', 'name', 'replyTo', 'groupId', 'page', 'uid', 'createdAt'])
        && d.topic in ['question', 'privacy', 'abuse', 'bug', 'idea', 'other']
        && d.message is string && d.message.size() > 0 && d.message.size() <= 2000
        && (!('name' in d) || (d.name is string && d.name.size() <= 60))
        && (!('replyTo' in d) || (d.replyTo is string && d.replyTo.size() <= 100))
        && (!('groupId' in d) || (d.groupId is string && d.groupId.size() <= 40))
        && (!('page' in d) || (d.page is string && d.page.size() <= 20))
        && d.uid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /contact_messages/{msgId} {
      allow create: if contactMessageOk();
      allow read, update, delete: if isSuperAdmin();
    }

    // כל שאר הנתיבים חסומים
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
